# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GAME_SERVER_URL: Endereço do Servidor WebSocket / REST Multiplayer.
# Para produção na Netlify, aponte para o serviço do servidor (ex: https://meu-servidor.onrender.com).
# Quando vazio em desenvolvimento, o cliente se conecta automaticamente a window.location.host.
VITE_GAME_SERVER_URL=""

# PORT & CORS (Para o servidor multiplayer persistente)
PORT=3000
ALLOWED_ORIGINS="*"
