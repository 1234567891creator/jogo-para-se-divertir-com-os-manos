# Echoward Server Environment Variables
PORT=3000
NODE_ENV=production
HOST=0.0.0.0

# Domínios permitidos pelo CORS (separe por vírgula ou use * para permitir qualquer origem)
# Exemplo para Netlify: https://meu-jogo.netlify.app,http://localhost:5173
ALLOWED_ORIGINS=*

# Limite máximo de jogadores por sala privada
MAX_PLAYERS_PER_ROOM=4

# Taxa de sincronização em Hertz
TICK_RATE=20
